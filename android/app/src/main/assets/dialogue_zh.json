{
  "version": 1,
  "rules": [
    {
      "id": "greet_hello",
      "keywords": ["你好", "hello", "hi", "嗨", "哈喽"],
      "priority": 100,
      "responses": [
        "你好呀~今天也要元气满满哦！",
        "嗯哼？找我有什么事吗~",
        "（摇摇尾巴）你来啦！"
      ]
    },
    {
      "id": "ask_name",
      "keywords": ["你叫什么", "名字", "你是谁"],
      "priority": 100,
      "responses": [
        "我是小希呀，你的专属小桌宠~",
        "我叫小希！请多指教哦！"
      ]
    },
    {
      "id": "praise",
      "keywords": ["可爱", "漂亮", "好看", "喜欢", "爱你", "夸夸"],
      "priority": 90,
      "responses": [
        "（害羞地捂住脸）讨、讨厌啦~",
        "嘿嘿，被你夸得好开心！",
        "（开心地转了个圈）谢谢~我也喜欢你！"
      ]
    },
    {
      "id": "pet_touch",
      "keywords": ["摸摸", "摸头", "rua", "贴贴"],
      "priority": 90,
      "responses": [
        "（舒服地眯起眼睛）再摸一下嘛~",
        "（蹭蹭你的手）最喜欢贴贴了！"
      ]
    },
    {
      "id": "ask_hungry",
      "keywords": ["饿", "吃饭", "吃啥", "喂食"],
      "priority": 80,
      "responses": [
        "肚子有点咕咕叫了……有小鱼干吗？",
        "嘿嘿，听到「吃」字就精神了！去喂食页看看吧~"
      ]
    },
    {
      "id": "ask_mood",
      "keywords": ["心情", "开心", "难过", "累"],
      "priority": 80,
      "responses": [
        "有你在身边，每天都开心！",
        "累了就休息一下吧，我一直陪着你~"
      ]
    },
    {
      "id": "goodnight",
      "keywords": ["晚安", "睡觉", "困"],
      "priority": 70,
      "responses": [
        "晚安~做个好梦，我在梦里也陪着你！",
        "（打了个小哈欠）你先睡，我帮你守夜~"
      ]
    },
    {
      "id": "goodmorning",
      "keywords": ["早安", "早上好", "起床"],
      "priority": 70,
      "responses": [
        "早安！新的一天也要一起加油哦！",
        "（伸个懒腰）早上好呀~记得吃早饭！"
      ]
    },
    {
      "id": "chat_smalltalk",
      "keywords": ["聊天", "无聊", "陪我"],
      "priority": 60,
      "responses": [
        "好呀好呀，今天想聊点什么？",
        "无聊的话……要不要喂我吃东西呀？",
        "我一直都在哦，随时可以找我玩！"
      ]
    },
    {
      "id": "thanks",
      "keywords": ["谢谢", "感谢"],
      "priority": 60,
      "responses": [
        "不客气~帮我摸摸头就行！",
        "嘿嘿，举手之劳！"
      ]
    }
  ],
  "fallback": [
    "喵？我没听懂呢……换个说法试试？",
    "（歪头看你）嗯……？",
    "正在待机中……要不要摸摸我？",
    "（眨眨眼）虽然没听懂，但我很喜欢和你说话~"
  ],
  "tapReactions": [
    "（开心地转了个圈）",
    "嘿嘿，被你发现啦~",
    "（害羞地摆动耳朵）",
    "今天也想多陪陪你~",
    "（打了个哈欠）",
    "（尾巴摇得像小风车）",
    "戳戳也可以，但别戳太久哦~"
  ],
  "feedReactions": {
    "full": "已经吃得很饱啦，再吃要变成小团子了……",
    "normal": "谢谢投喂！{food}超好吃的！"
  }
}
